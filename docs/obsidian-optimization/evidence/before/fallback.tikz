% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-1,0) to[R, fill=white, name=dcComponent0] (1,0);
% Component: capacitor
\draw[draw=dcColor0, line width=1.4226pt] (2.75,0) to[C, fill=white, name=dcComponent1] (4.75,0);
% Component: inductor
\draw[draw=dcColor0, line width=1.4226pt] (6.5,0) to[L, fill=white, name=dcComponent2] (8.5,0);
% Component: voltageSource
\draw[draw=dcColor0, line width=1.4226pt] (10.25,0) to[american voltage source, fill=white, name=dcComponent3] (12.25,0);
% Component: diode
\draw[draw=dcColor0, line width=1.4226pt] (14,0) to[D, fill=white, name=dcComponent4] (16,0);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (0,0.75) {$R_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (3.75,0.75) {$R_2$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (7.5,0.75) {$R_3$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (11.25,0.75) {$R_4$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (15,0.75) {$R_5$};
\end{circuitikz}