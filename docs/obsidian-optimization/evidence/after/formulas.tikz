% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,0) {$\frac{R_1 R_2}{R_1+R_2}=\sqrt{L/C}$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (14.5,0) {$\mathbf{V}_{out}=\sum_{k=1}^{10}\frac{a_k}{1+s\tau_k}$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,-2.75) {$\int_0^{\infty} e^{-st} f(t)\,dt$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (14.5,-2.75) {$\begin{pmatrix}R_1 & -R_2\\-R_2 & R_3\end{pmatrix}$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,-5.5) {$\overline{V}_{AB}^{\prime\prime}=\hat{I} Z$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (14.5,-5.5) {$\left(\frac{a+b}{c+d}\right)^2+\sqrt[3]{x^2+1}$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,-8.25) {$\color{red}{R_1}+\color{blue}{R_2}=\text{totale}$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (14.5,-8.25) {$\underbrace{R_1+R_2+R_3}_{R_{eq}}$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,-11) {$\mathbb{R}\ni x\quad\therefore x\geq 0$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (14.5,-11) {$\frac{d^2v}{dt^2}+2\zeta\omega_0\frac{dv}{dt}+\omega_0^2v=0$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,-13.75) {$V^{\prime\prime}+I^{\prime}=\textbf{Ingresso}$};
\node[text=dcColor0, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (14.5,-13.75) {$\begin{cases}x^2&x>0\\-x&x\leq0\end{cases}$};
