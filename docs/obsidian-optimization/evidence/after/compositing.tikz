% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{F05533}
\definecolor{dcColor1}{HTML}{171A20}
\definecolor{dcColor2}{HTML}{2463CB}
\definecolor{dcColor3}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\path[fill=dcColor0, fill opacity=0.35] (-2.25,-0.5) rectangle (0.5,-2.5);
\draw[draw=dcColor1, opacity=0.7, line width=1.4226pt, dash pattern=on 5.6906pt off 2.8453pt] (-2.25,-0.5) rectangle (0.5,-2.5);
\draw[draw=dcColor1, opacity=0.3, line width=8.5358pt] (0,0) -- (5,0);
\path[fill=dcColor0, fill opacity=0.35] (-1.5,-0.5) rectangle (1.25,-2.5);
\draw[draw=dcColor1, opacity=0.7, line width=1.4226pt, dash pattern=on 5.6906pt off 2.8453pt] (-1.5,-0.5) rectangle (1.25,-2.5);
\draw[draw=dcColor1, opacity=0.3, line width=8.5358pt] (0,-0.25) -- (5,-0.25);
\path[fill=dcColor0, fill opacity=0.35] (-0.75,-0.5) rectangle (2,-2.5);
\draw[draw=dcColor1, opacity=0.7, line width=1.4226pt, dash pattern=on 5.6906pt off 2.8453pt] (-0.75,-0.5) rectangle (2,-2.5);
\draw[draw=dcColor1, opacity=0.3, line width=8.5358pt] (0,-0.5) -- (5,-0.5);
\path[fill=dcColor0, fill opacity=0.35] (0,-0.5) rectangle (2.75,-2.5);
\draw[draw=dcColor1, opacity=0.7, line width=1.4226pt, dash pattern=on 5.6906pt off 2.8453pt] (0,-0.5) rectangle (2.75,-2.5);
\draw[draw=dcColor1, opacity=0.3, line width=8.5358pt] (0,-0.75) -- (5,-0.75);
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (-1,0) to[R, fill=white, name=dcComponent0] (1,0);
\begin{scope}[opacity=0.35, transparency group]
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (0.125,0) to[R, fill=white, name=dcComponent1] (2.125,0);
\end{scope}
\begin{scope}[opacity=0.35, transparency group]
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (1.25,0) to[R, fill=white, name=dcComponent2] (3.25,0);
\end{scope}
\begin{scope}[opacity=0.35, transparency group]
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (2.375,0) to[R, fill=white, name=dcComponent3] (4.375,0);
\end{scope}
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (0,0.75) {$R_1$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (1.125,0.75) {$R_1$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2.25,0.75) {$R_1$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (3.375,0.75) {$R_1$};
\begin{scope}[opacity=0.45, transparency group]
\node[text=dcColor3, anchor=west, inner sep=0pt, rotate=-45, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,-3.75) {$\mathbf{R}_1$};
\end{scope}
\begin{scope}[opacity=0.45, transparency group]
\node[text=dcColor3, anchor=west, inner sep=0pt, rotate=-90, font=\fontsize{17.0717}{22.1931}\selectfont] at (0.25,-3.75) {$\mathbf{R}_1$};
\end{scope}
\begin{scope}[opacity=0.45, transparency group]
\node[text=dcColor3, anchor=west, inner sep=0pt, rotate=-135, font=\fontsize{17.0717}{22.1931}\selectfont] at (0.5,-3.75) {$\mathbf{R}_1$};
\end{scope}
\begin{scope}[opacity=0.45, transparency group]
\node[text=dcColor3, anchor=west, inner sep=0pt, rotate=-180, font=\fontsize{17.0717}{22.1931}\selectfont] at (0.75,-3.75) {$\mathbf{R}_1$};
\end{scope}
\end{circuitikz}