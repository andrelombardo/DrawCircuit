% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{56B4E9}
\definecolor{dcColor1}{HTML}{171A20}
\definecolor{dcColor2}{HTML}{EFCC88}
\definecolor{dcColor3}{HTML}{6942B5}
\definecolor{dcColor4}{HTML}{2463CB}
\definecolor{dcColor5}{HTML}{DF4949}
\definecolor{dcColor6}{HTML}{269978}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\path[fill=dcColor0, fill opacity=0.18] (-7.75,5.125) rectangle (7.75,-6.875);
\draw[draw=dcColor1, opacity=0.45, line width=1.4226pt, dash pattern=on 5.6906pt off 2.8453pt] (-7.75,5.125) rectangle (7.75,-6.875);
\path[fill=dcColor2, fill opacity=0.35] (-7.25,-1) rectangle (2,-6);
\draw[draw=dcColor1, opacity=0.6, line width=1.4226pt] (-7.25,-1) rectangle (2,-6);
\draw[draw=dcColor3, opacity=0.4, line width=1.4226pt, dash pattern=on 0pt off 4.2679pt] (-7.25,-4.75) -- (7,3.5);
\draw[draw=dcColor1, line width=1.4226pt] (-4,0) -- (-6,0);
\draw[draw=dcColor1, line width=1.4226pt] (-2,0) -- (0,0);
\draw[draw=dcColor1, line width=1.4226pt] (2,0) -- (0,0);
\draw[draw=dcColor1, line width=1.4226pt] (4,0) -- (6,0);
\draw[draw=dcColor1, line width=1.4226pt] (-6,-2) -- (-6,0);
\draw[draw=dcColor1, line width=1.4226pt] (-6,-4) -- (-6,-5.5) -- (0,-5.5);
\draw[draw=dcColor1, line width=1.4226pt] (0,-2) -- (0,0);
\draw[draw=dcColor1, line width=1.4226pt] (0,-4) -- (0,-5.5);
\draw[draw=dcColor1, line width=1.4226pt] (6,-2) -- (6,0);
\draw[draw=dcColor1, line width=1.4226pt] (6,-4) -- (6,-5.5) -- (0,-5.5);
\draw[draw=dcColor1, line width=1.4226pt] (-1,4) -- (-6,4) -- (-6,0);
\draw[draw=dcColor1, line width=1.4226pt] (1,4) -- (6,4) -- (6,0);
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (-4,0) to[R, fill=white, name=dcComponent0] (-2,0);
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (2,0) to[R, fill=white, name=dcComponent1] (4,0);
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (-1,4) to[R, fill=white, name=dcComponent2] (1,4);
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (-6,-2) to[R, fill=white, name=dcComponent3] (-6,-4);
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (0,-2) to[R, fill=white, name=dcComponent4] (0,-4);
% Component: resistor
\draw[draw=dcColor1, line width=1.4226pt] (6,-2) to[R, fill=white, name=dcComponent5] (6,-4);
\fill[dcColor1] (-6,0) circle (3.2009pt);
\fill[dcColor1] (0,0) circle (3.2009pt);
\fill[dcColor1] (6,0) circle (3.2009pt);
\fill[dcColor1] (0,-5.5) circle (3.2009pt);
\node[text=dcColor4, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-3,0.75) {$r_{AB}$};
\node[text=dcColor4, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (3,0.75) {$r_{BC}$};
\node[text=dcColor4, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (0,4.75) {$r_{AC}$};
\node[text=dcColor4, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-7.1,-3) {$r_{AD}$};
\node[text=dcColor4, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (1.1,-3) {$r_{BD}$};
\node[text=dcColor4, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (7.1,-3) {$r_{CD}$};
\node[text=dcColor5, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (-6.65,-0.125) {A};
\node[text=dcColor5, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (0,0.75) {B};
\node[text=dcColor5, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (6.65,-0.125) {C};
\node[text=dcColor5, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (0,-6.35) {D};
\draw[->, draw=dcColor5, line width=1.2804pt] (-1.95,-0.8813) arc[start angle=60, end angle=-250, radius=2.1cm];
\node[text=dcColor5, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{14.2264}{18.4943}\selectfont] at (-3,-2.925) {maglia 1};
\draw[->, draw=dcColor5, line width=1.2804pt] (-4.25,1.5) .. controls (-3.875,2.075) and (-2,2.075) .. (-1.625,1.5);
\node[text=dcColor5, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-3,2.5) {$i_1$};
\begin{scope}[opacity=0.55, transparency group]
\begin{scope}[rotate around={-35:(-2.875,-1.875)}]
\draw[->, draw=dcColor4, line width=2.134pt] (-0.75,-1.875) arc[start angle=0, end angle=324, x radius=2.125cm, y radius=1.375cm];
\end{scope}
\end{scope}
% Annotation: brace
\draw[draw=dcColor4, line width=1.4226pt] (-6,-7.25) .. controls (-6,-7.6) and (-5.65,-7.6) .. (-5.3,-7.6) -- (-0.7,-7.6) .. controls (-0.35,-7.6) and (0,-7.6) .. (0,-7.95) .. controls (0,-7.6) and (0.35,-7.6) .. (0.7,-7.6) -- (5.3,-7.6) .. controls (5.65,-7.6) and (6,-7.6) .. (6,-7.25);
\node[text=dcColor5, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (0,-8.39) {$\mathbf{R}_{eq}=\frac{R_1R_2}{R_1+R_2}$};
\begin{scope}[opacity=0.75, transparency group]
% Electrical annotation: voltage
\draw[draw=dcColor6,line width=1.4226pt] (7.75,3.5) -- (7.75,-5);
\draw[draw=dcColor6,line width=1.4226pt] (7.6625,-4.8) -- (7.75,-5) -- (7.8375,-4.8);
\end{scope}
\begin{scope}[opacity=0.6, transparency group]
\node[text=dcColor6, anchor=center, inner sep=0pt, rotate=-90, font=\fontsize{15.649}{20.3437}\selectfont] at (8.35,-0.75) {$V_{AB}$};
\end{scope}
\end{circuitikz}